{
  "name": "enterpriseos-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:check": "node scripts/migrate.js --check",
    "create-admin": "node scripts/create-admin.js",
    "bootstrap:tenant": "node scripts/bootstrap-tenant.js",
    "syntax": "node scripts/check-syntax.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "audit:all": "npm audit --audit-level=low",
    "verify": "npm run syntax && npm test && npm run audit:all"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
